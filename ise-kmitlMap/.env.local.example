# ── โหมด mock in-memory (ค่าเริ่มต้น) ──
# ไม่ต้องตั้งค่าอะไรเลย — แต่บน Vercel ข้อมูลจะหายทุกครั้งที่ฟังก์ชันถูกรีไซเคิล
# ใช้ได้เฉพาะตอน demo เท่านั้น

# ── โหมด PostgreSQL (แนะนำสำหรับ Vercel) ──
# สร้าง DB จาก Vercel Postgres / Neon / Supabase แล้วรัน db/schema.sql + db/seed.sql
# จากนั้นตั้งค่านี้ใน Vercel → Settings → Environment Variables
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DB_SSL=true

# ── ถ้ารันบน VM/Cloud Run ผ่าน Unix socket ให้ใช้ 4 ตัวแปรนี้แทน DATABASE_URL ──
# INSTANCE_UNIX_SOCKET=/cloudsql/PROJECT_ID:asia-southeast1:kmitlmap-db
# DB_USER=kmitlmap
# DB_PASS=YOUR_PASSWORD
# DB_NAME=kmitlmap
